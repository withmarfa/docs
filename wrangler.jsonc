{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marfa-docs",
  "compatibility_date": "2026-05-29",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // The Worker runs ahead of the static files for every address but the
  // build's own hashed files and the icons, so it can read `Accept` on a
  // prerendered page and serve its Markdown copy. It hands every other request
  // to the files itself (`src/lib/worker.ts`). The icons are listed because the
  // Worker has nothing to add to them.
  //
  // Prerender writes each page as `<path>/index.html`. By default the files
  // would answer that page at `<path>/` and redirect every link, which has no
  // slash, with a 307. `drop-trailing-slash` answers it at `<path>`; the Worker
  // turns the slash form into a permanent redirect before the files see it.
  "assets": {
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/*", "!/assets/*", "!/favicon.*", "!/apple-touch-icon.png"]
  },
  // A per-client limit on the public addresses that need no credential
  // (`src/lib/rate-limit.ts`), and one on how many reads an address can cause
  // to be counted (`src/lib/agent-reads.ts`). The window is 60 seconds, which
  // the 429's `Retry-After` repeats. A namespace_id is unique within the
  // account, and two bindings with one id would share a count, so each
  // limiter has its own.
  //
  // The numbers sit well above what an honest agent does. A session of
  // searching and reading makes a few requests a minute at most, and `/mcp`
  // carries the handshake and every tool call as separate requests. A flood
  // reaches the limit within seconds. The search box's debounce is 100
  // milliseconds and a person types a query a few times a minute, so 300 is
  // never reached by typing. The counts are per Cloudflare location, and a
  // key is an IP address, which a service calling for many people shares.
  "ratelimits": [
    {
      "name": "DOCS_MCP_LIMITER",
      "namespace_id": "5701",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "DOCS_SEARCH_LIMITER",
      "namespace_id": "5702",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "DOCS_COUNT_LIMITER",
      "namespace_id": "5703",
      "simple": { "limit": 600, "period": 60 }
    },
    {
      "name": "DOCS_SITE_SEARCH_LIMITER",
      "namespace_id": "5704",
      "simple": { "limit": 300, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "docs.marfa.so",
      "custom_domain": true
    }
  ]
}
