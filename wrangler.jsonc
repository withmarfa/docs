{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marfa-docs",
  "compatibility_date": "2026-05-29",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // The Worker runs ahead of the static files for every address but the
  // build's own hashed files and the icons, so it can read `Accept` on a
  // prerendered page and serve its Markdown copy. It hands every other request
  // to the files itself (`src/lib/worker.ts`). The icons are listed because the
  // Worker has nothing to add to them.
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*", "!/favicon.*", "!/apple-touch-icon.png"]
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "docs.marfa.so",
      "custom_domain": true
    }
  ]
}
