{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marfa-docs",
  "compatibility_date": "2026-05-29",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // The Worker runs ahead of the static files for every address but the
  // build's own hashed files and the icons, so it can read `Accept` on a
  // prerendered page and serve its Markdown copy. It hands every other request
  // to the files itself (`src/lib/worker.ts`). The icons are listed because the
  // Worker has nothing to add to them.
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*", "!/favicon.*", "!/apple-touch-icon.png"]
  },
  // A per-client limit on the two public addresses that need no credential
  // (`src/lib/rate-limit.ts`). The window is 60 seconds, which the 429's
  // `Retry-After` repeats. A namespace_id is unique within the account, and two
  // bindings with one id would share a count, so each limiter has its own.
  //
  // The numbers sit well above what an honest agent does. A session of
  // searching and reading makes a few requests a minute at most, and `/mcp`
  // carries the handshake and every tool call as separate requests. A flood
  // reaches the limit within seconds. The counts are per Cloudflare location.
  "ratelimits": [
    {
      "name": "DOCS_MCP_LIMITER",
      "namespace_id": "5701",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "DOCS_SEARCH_LIMITER",
      "namespace_id": "5702",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "docs.marfa.so",
      "custom_domain": true
    }
  ]
}
