{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marfa-status",
  "compatibility_date": "2026-05-29",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true
  },
  // The store the checker writes to, bound read-only in practice: this Worker
  // only ever selects. A binding is not a subrequest, so two Workers reading
  // one database is an ordinary topology rather than a workaround.
  //
  // The id is real rather than a placeholder. It names a resource on one
  // account and is useless without that account's credentials, and a
  // placeholder here would mean the one command a contributor runs first is
  // the one that fails.
  "d1_databases": [
    {
      "binding": "UPTIMEFLARE_D1",
      "database_name": "uptimeflare_d1",
      "database_id": "faedb28a-cc84-4cbc-baf5-adc7d31cf23a"
    }
  ]
}
