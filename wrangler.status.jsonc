{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marfa-status",
  "compatibility_date": "2026-05-29",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true
  },
  // A route rather than a custom domain, and it stays a route.
  //
  // The hostname already had a proxied CNAME pointing at the front end this
  // replaces. A custom domain cannot be created over an existing record, and
  // deleting the record first opens a window where the name does not resolve
  // at all. A route takes precedence over whatever the record points at and
  // needs only that the record exist and be proxied, so attaching one is
  // gapless and removing it reverts instantly.
  //
  // Converting to a custom domain later would require the record to be gone
  // first, reintroducing exactly that gap. The asymmetry with how the docs
  // site is wired is cosmetic.
  //
  // Note that routes are additive: deleting this entry and redeploying does
  // not remove the route.
  "routes": [
    {
      "pattern": "status.marfa.so/*",
      "zone_name": "marfa.so"
    }
  ],
  // Kept on deliberately, though declaring a route would otherwise turn it off.
  //
  // Two reasons. The publish workflow proves its deploy by fetching the version
  // endpoint, and it needs an address that works before the route exists. And a
  // status page reachable only through the zone it reports on loses its
  // audience precisely when that zone has a problem, which is the one failure
  // this page exists to survive.
  "workers_dev": true,
  // The store the checker writes to, bound read-only in practice: this Worker
  // only ever selects. A binding is not a subrequest, so two Workers reading
  // one database is an ordinary topology rather than a workaround.
  //
  // The id is real rather than a placeholder. It names a resource on one
  // account and is useless without that account's credentials, and a
  // placeholder here would mean the one command a contributor runs first is
  // the one that fails.
  "d1_databases": [
    {
      "binding": "UPTIMEFLARE_D1",
      "database_name": "uptimeflare_d1",
      "database_id": "faedb28a-cc84-4cbc-baf5-adc7d31cf23a"
    }
  ]
}
