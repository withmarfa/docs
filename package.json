{
  "name": "marfa-docs",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:status": "vite build -c vite.status.config.ts",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:status": "pnpm run build:status && wrangler deploy -c dist-status/server/wrangler.json",
    "cf-typegen": "wrangler types",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "snippets:check": "node scripts/check-snippets.mjs",
    "mcp:stdio": "node --experimental-strip-types src/lib/mcp/stdio.ts",
    "postinstall": "fumadocs-mdx",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-start": "1.168.49",
    "fumadocs-core": "^16.15.5",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-openapi": "^11.4.0",
    "fumadocs-ui": "^16.15.5",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "vite": "^8.2.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@withmarfa/sdk": "5.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0",
    "yaml": "2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
