{
  "name": "marfa-docs",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "snippets:check": "node scripts/check-snippets.mjs",
    "mcp:stdio": "node --experimental-strip-types src/lib/mcp/stdio.ts",
    "postinstall": "fumadocs-mdx",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-start": "1.168.32",
    "fumadocs-core": "^16.13.0",
    "fumadocs-mdx": "^15.2.0",
    "fumadocs-openapi": "^11.2.2",
    "fumadocs-ui": "^16.13.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "vite": "^8.1.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.48.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@withmarfa/sdk": "5.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0",
    "yaml": "2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
