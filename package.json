{
  "name": "marfa-docs",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:status": "vite build -c vite.status.config.ts",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:status": "pnpm run build:status && wrangler deploy -c dist-status/server/wrangler.json",
    "cf-typegen": "wrangler types",
    "types:check": "fumadocs-mdx && tsc --noEmit && tsc --noEmit -p tsconfig.status.json",
    "mcp:stdio": "node --experimental-strip-types src/lib/mcp/stdio.ts",
    "postinstall": "fumadocs-mdx",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.0",
    "@modelcontextprotocol/server": "^2.3.0",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.3",
    "fumadocs-core": "^16.15.15",
    "fumadocs-mdx": "^15.4.5",
    "fumadocs-openapi": "^12.4.1",
    "fumadocs-ui": "^16.15.15",
    "lucide-react": "^1.48.0",
    "posthog-js": "^1.434.16",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "vite": "^8.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "wrangler": "^4.149.0",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
